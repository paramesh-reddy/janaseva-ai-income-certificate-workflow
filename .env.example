# GEMINI_API_KEY: Required for Gemini AI document review, OCR and discrepancy analysis.
# Configure this with your Google Gemini API key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL database connection string (Supabase / Render / Neon / Cloud SQL)
# When not provided or local, defaults to internal in-memory / SQLite fallback.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/janaseva_db"

# JWT_SECRET: Secret key for signing officer session authentication tokens
JWT_SECRET="janaseva-karnataka-gov-revenue-secret-key-2026"

# PORT: Server port (default 3000)
PORT=3000
